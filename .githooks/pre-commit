#!/bin/sh
# NovelCast pre-commit: lint + unit tests must pass before every commit.
# Bypass (only when you really mean it): git commit --no-verify
set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

vendor="$root/.vendor"
if command -v cygpath >/dev/null 2>&1; then
    vendor=$(cygpath -w "$vendor")
    export PYTHONPATH="$vendor${PYTHONPATH:+;$PYTHONPATH}"
else
    export PYTHONPATH="$vendor${PYTHONPATH:+:$PYTHONPATH}"
fi

py="${NOVELCAST_PYTHON:-}"
if [ -z "$py" ]; then
    if command -v python >/dev/null 2>&1; then
        py=python
    elif command -v py >/dev/null 2>&1; then
        py="py -3"
    else
        echo "pre-commit: python not found; set NOVELCAST_PYTHON=/path/to/python" >&2
        exit 1
    fi
fi

ruff_bin="$root/.vendor/ruff-0.17.5.data/scripts/ruff.exe"
if command -v ruff >/dev/null 2>&1; then
    ruff check novelcast scripts tests
elif [ -x "$ruff_bin" ]; then
    "$ruff_bin" check novelcast scripts tests
else
    echo "pre-commit: ruff not found (pip install -e '.[dev]')" >&2
    exit 1
fi

# shellcheck disable=SC2086
$py -m pytest -q
